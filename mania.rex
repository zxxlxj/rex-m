{
  "name": "MANIA",
  "title": "MANIA",
  "description": "包含 MANIA 影视与 RAVE 音乐两个模块。",
  "icon": "https://raw.githubusercontent.com/zxxlxj/rex-m/main/assets/mania.png?v=2.1.1",
  "logo": "https://raw.githubusercontent.com/zxxlxj/rex-m/main/assets/mania.png?v=2.1.1",
  "widgets": [
    {
      "id": "dian115.virtual-cache",
      "title": "MANIA",
      "description": "连接你自行部署的媒体服务，获取资源并播放。",
      "requiredVersion": "0.0.1",
      "version": "2.2.1",
      "author": "MANIA",
      "icon": "https://raw.githubusercontent.com/zxxlxj/rex-m/main/assets/mania.png?v=2.1.1",
      "url": "https://raw.githubusercontent.com/zxxlxj/rex-m/main/docs/plugin-platform/examples/mania/mania.rex.js"
    },
    {
      "id": "dian115.rave-music",
      "title": "RAVE 音乐",
      "description": "连接 RAVE 媒体服务器，浏览和播放 OpenSubsonic 音乐。",
      "requiredVersion": "0.0.1",
      "version": "1.0.0",
      "author": "MANIA",
      "icon": "https://raw.githubusercontent.com/zxxlxj/rex-m/main/assets/mania.png?v=2.1.1",
      "url": "https://raw.githubusercontent.com/zxxlxj/rex-m/main/docs/plugin-platform/examples/rave-music/rave-music.rex.js"
    }
  ]
}
